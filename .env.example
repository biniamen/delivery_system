# Copy to .env for Docker Compose. Never commit the resulting .env file.
POSTGRES_DB=creavers_delivery
POSTGRES_USER=creavers_app
POSTGRES_PASSWORD=replace-with-a-long-local-password
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
CUSTOMER_DEMO_PASSWORD=replace-with-a-demo-only-password
DISPATCHER_DEMO_PASSWORD=replace-with-a-demo-only-password
DRIVER_DEMO_PASSWORD=replace-with-a-demo-only-password
STORE_ADMIN_DEMO_PASSWORD=replace-with-a-demo-only-password
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_SERVER_API_KEY=replace-with-an-ip-restricted-server-key
GOOGLE_MAPS_BROWSER_API_KEY=replace-with-a-referrer-restricted-browser-key
GOOGLE_MAPS_ANDROID_API_KEY=replace-with-an-android-app-restricted-key
GOOGLE_MAPS_IOS_API_KEY=replace-with-an-ios-app-restricted-key
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
