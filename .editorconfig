root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,ts}]
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion

[*.{html,css,json,yml,yaml,md}]
indent_style = space
indent_size = 2

# EF Core owns migration source shape; application code remains fully analyzed.
[backend/src/Creavers.Delivery.Infrastructure/Persistence/Migrations/*.cs]
dotnet_diagnostic.CA1861.severity = none
